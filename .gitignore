# Credentials and local configuration
**/.env
**/.env.*
!.env.example

# Python environments, caches, and generated bytecode
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.cache/*
!/.cache/openalex_cache.json.gz
**/*.py[cod]

# JavaScript build/dependency artifacts
**/node_modules/
**/.next/
**/coverage/
**/*.tsbuildinfo

# Local corpora and text-bearing extraction outputs
/corpus*.jsonl
!/corpus_main_v4.jsonl
/excluded*.jsonl
/gapfinder/corpus*.jsonl
/gapfinder/excluded*.jsonl
/experiments/runs/
/runs/
/gapfinder/runs/
/gapfinder/experiments/runs/*
!/gapfinder/experiments/runs/retrieval/
!/gapfinder/experiments/runs/retrieval_sensitivity_unresolved30/
!/gapfinder/experiments/runs/phase3_full_corpus_v4_gemini31_low/
!/gapfinder/experiments/runs/phase3_v4_semantic_annotation_metrics.json
/gapfinder/experiments/runs/retrieval/*
!/gapfinder/experiments/runs/retrieval/metrics.csv
/gapfinder/experiments/runs/retrieval_sensitivity_unresolved30/*
!/gapfinder/experiments/runs/retrieval_sensitivity_unresolved30/metrics.csv
/gapfinder/experiments/runs/phase3_full_corpus_v4_gemini31_low/*
!/gapfinder/experiments/runs/phase3_full_corpus_v4_gemini31_low/summary.json

# Source corpus and derived text/annotation files
/repro/corpus/
/repro/corpus_live/
/repro/live_cache/
/repro/sparsity_coarse/
/repro/sparsity_coarse_chain/
/repro/sparsity_fine/
/repro/annotated_v4.csv
/repro/extractions*.jsonl

# Embedding/model artifacts and editor/OS files
**/*.npz
**/*.pt
**/*.bin
.DS_Store
Thumbs.db
